# App artifacts
/_build
/db
/deps
/*.ez
/test/instance
/test/uploads
/.elixir_ls
/test/fixtures/DSCN0010_tmp.jpg
/test/fixtures/test_tmp.txt
/test/fixtures/image_tmp.jpg
/test/tmp/
/test/frontend_static_test/
/doc
/instance
/priv/ssh_keys

# Prevent committing custom emojis
/priv/static/emoji/custom/*

# Generated on crash by the VM
erl_crash.dump

# Scratch archives may contain source snapshots or local configuration.
/.strict-*.tar

# Local configuration files may contain credentials. Environment examples
# remain uploadable because deployment documentation depends on them.
*.secret.exs
!/test/fixtures/**/*.secret.exs
/config/generated_config.exs
/config/runtime.exs
*.env
*.env.*
!*.env.example

# Private key containers must stay local. Public certificates and the
# repository's tracked test fixtures are not affected by these patterns.
*.key
*.p12
*.pfx

# Database setup file, some may forget to delete it
/config/setup_db*.psql

.DS_Store
Thumbs.db
Desktop.ini

# Editor config
/.vscode/

# Prevent committing docs files
/priv/static/doc/*
docs/generated_config.md

# Code test coverage
/cover
/Elixir.*.coverdata
/coverage.xml

# Language and package-manager caches
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
npm-debug.log*
yarn-error.log*

.idea
pleroma.iml

# Editor temp files
*~
*#
.#*
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej
soapbox.zip
InstallationLog.txt
toolshim
toolshim/**
