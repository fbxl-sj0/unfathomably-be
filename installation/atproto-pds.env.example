# Unfathomably AT Protocol PDS
# --------------------------------
#
# File: atproto-pds.env.example
#
# Purpose:
#   Document the non-secret runtime configuration for the local-account PDS.
#
# Responsibilities:
#   - keep the PDS endpoint separate from the public handle namespace
#   - allow managed handles below social.fbxl.net
#   - announce local repository changes to the public Bluesky crawler
#
# This file intentionally does NOT contain production secrets or configure a
# relay, AppView, firehose mirror, Redis service, or external blob store.

PDS_HOSTNAME=pds.fbxl.net
PDS_PORT=3000
PDS_SERVICE_HANDLE_DOMAINS=.social.fbxl.net
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=33554432
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network
PDS_INVITE_REQUIRED=true
PDS_RATE_LIMITS_ENABLED=true
PDS_ACCEPTING_REPO_IMPORTS=false
PDS_SERVICE_NAME=Unfathomably AT Protocol accounts
PDS_HOME_URL=https://social.fbxl.net
PDS_SUPPORT_URL=https://social.fbxl.net/about
LOG_ENABLED=true
LOG_LEVEL=info

# Required secrets are generated directly on the server. These placeholders
# must never be used as live values.
PDS_JWT_SECRET=__PDS_JWT_SECRET__
PDS_DPOP_SECRET=__PDS_DPOP_SECRET__
PDS_ADMIN_PASSWORD=__PDS_ADMIN_PASSWORD__
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=__PDS_PLC_ROTATION_KEY__

# end of atproto-pds.env.example
